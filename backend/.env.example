# Copy to .env and fill in. .env is git-ignored - never commit real secrets.
# With `docker compose up` the database settings and FRONTEND_URLS come from docker-compose.yml;
# the database lines here are for running the backend on its own or against a hosted database.

# Neon (or Supabase): the direct connection, keep ?sslmode=require
# DB_URL=jdbc:postgresql://ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your-database-password

# Any long random string (32+ characters)
# JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Google AI Studio key (https://aistudio.google.com/apikey). Without it the app works and AI buttons say "not configured".
# AI_API_KEY=
# Optional overrides
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_CHAT_MODEL=gemini-2.5-flash
# AI_EMBEDDING_MODEL=gemini-embedding-001
# AI requests one student may make per hour (assistant, résumé, drafts, task ideas); 0 for no limit
# ASSISTANT_QUESTIONS_PER_HOUR=10

# Allowed frontend origins, comma-separated; * matches any part, e.g. https://campus-connect-*.vercel.app
# FRONTEND_URLS=http://localhost:5173

# Automation (optional)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/campusconnect
# AUTOMATION_API_KEY=another-long-random-string
# GITHUB_WEBHOOK_SECRET=secret-you-also-enter-in-github
