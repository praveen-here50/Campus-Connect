# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# Supabase -> Connect -> Session pooler (keep ?sslmode=require)
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Any long random string (32+ characters)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Google AI Studio key (https://aistudio.google.com/apikey)
AI_API_KEY=your-gemini-api-key
# Optional overrides
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_CHAT_MODEL=gemini-2.5-flash
# AI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated list of allowed frontend origins
FRONTEND_URLS=http://localhost:5173

# Automation (optional)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/campusconnect
# AUTOMATION_API_KEY=another-long-random-string
# GITHUB_WEBHOOK_SECRET=secret-you-also-enter-in-github
