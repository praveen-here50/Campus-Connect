# Backend base URL for production builds, e.g. https://campusconnect-backend.onrender.com (on Vercel: Settings >
# Environment Variables). Live chat connects to the same host over wss://. Leave empty in development: Vite
# proxies /api and /ws to http://localhost:8080.
VITE_API_URL=

# Public demo: shows a "Try the demo" card on the sign-in page with this account. Leave unset to hide it.
# VITE_DEMO_EMAIL=demo@demo.campus.edu
# VITE_DEMO_PASSWORD=campus-demo-1
