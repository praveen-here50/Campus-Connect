# Read by docker compose. Copy to .env (never commit .env: it is in .gitignore).
# Backend secrets (AI key, JWT secret) go in backend/.env instead; see backend/.env.example.

# Browser origins allowed to sign in and use live chat. To use a phone on your Wi-Fi, add its network,
# e.g. http://192.168.*:5173 or http://10.*:5173 (* matches any part, so a changed Wi-Fi address keeps working).
# FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Emails through n8n (docker compose --profile automation up); see "Automation" in README.md.
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/campusconnect
# MAIL_FROM=CampusConnect <you@gmail.com>
